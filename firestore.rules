rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // GLOBAL HELPERS
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && 
        request.auth.token.get('email', '').lower() in [
          'mdashik23010@gmail.com',
          'loverblack2022@gmail.com'
        ];
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // -------------------------------------------------------------------------
    // VALIDATION BLUEPRINTS
    // -------------------------------------------------------------------------
    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'price', 'category']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 200 &&
             data.price is number &&
             data.category is string;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name']) &&
             data.id is string &&
             data.name is string;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'customerInfo', 'items', 'total', 'userId', 'transactionId', 'lastNumber']) &&
             data.id is string &&
             data.total is number &&
             data.userId is string &&
             data.items is list &&
             data.transactionId is string &&
             data.lastNumber is string;
    }

    function isValidOffer(data) {
      return data.keys().hasAll(['id', 'title', 'image', 'status']) &&
             data.id is string &&
             data.title is string &&
             data.image is string &&
             data.status in ['active', 'hidden'];
    }

    // -------------------------------------------------------------------------
    // COLLECTIONS
    // -------------------------------------------------------------------------

    match /test/{docId} {
      allow read: if true;
    }

    match /configs/{docId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow get: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /offers/{offerId} {
      allow get, list: if true;
      allow write: if isAdmin() && isValidOffer(incoming());
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------------------
    // DEFAULT DENY (Bottom)
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
